# Copier en .env et remplir. Ne jamais commiter le .env.

# Config de la collectivite. Les valeurs par defaut ci-dessous ciblent
# L'Argentiere-la-Bessee. Pour un autre portail, ouvrir sa page de connexion et
# relever les champs caches api_key / type / db du formulaire.
CANTINE_BDD=cantine2_argentiere
CANTINE_API_KEY=cantine2
CANTINE_DB_ID=8089
CANTINE_TYPE_ID=9
CANTINE_PORTAIL=argentiere

# Prestation surveillee : regex testee sur le code et le libelle.
CANTINE_PRESTATION=RepE|Repas enfant

# Jours a ignorer (sortie scolaire avec pique-nique), YYYY-MM-DD separes par des virgules.
# Les mercredis, week-ends et vacances sont deja ecartes par le portail.
CANTINE_EXCLUSIONS=

# --- Base de donnees --------------------------------------------------------
# En local : docker compose up -d
DATABASE_URL=postgresql://cantine:cantine@localhost:5433/cantine

# --- Chiffrement ------------------------------------------------------------
# 32 octets aleatoires en base64 :  openssl rand -base64 32
# Une cle DIFFERENTE par environnement (local / preview / production).
# Perdre cette cle rend tous les mots de passe stockes definitivement illisibles.
CANTINE_CLE_CHIFFREMENT=

# --- Mail -------------------------------------------------------------------
# console = affiche le mail dans le terminal (defaut, aucun compte requis)
# brevo   = envoi reel, necessite BREVO_API_KEY
MAIL_PROVIDER=console
BREVO_API_KEY=
MAIL_EXPEDITEUR=cantine@exemple.fr
MAIL_EXPEDITEUR_NOM=Alerte cantine

# --- Application ------------------------------------------------------------
# Base publique, sert aux redirections et aux liens de connexion.
# Le schema est ajoute s'il manque ("mon-app.fr" devient "https://mon-app.fr").
# Sur Vercel, laisser vide suffit : VERCEL_PROJECT_PRODUCTION_URL prend le relais.
APP_URL=http://localhost:3000
# Signature des cookies de session : openssl rand -base64 32
SESSION_SECRET=
# Protege /api/cron. Vercel envoie "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Autorise /api/cron?date=YYYY-MM-DD pour tester les rappels en local.
# Laisser vide en production : la date choisit la semaine verifiee.
CANTINE_AUTORISER_DATE_SIMULEE=

# Connexion DIRECTE pour les migrations (Neon : hote SANS "-pooler").
# Le pooler ne conserve pas l'etat de session, dont les migrations et le verrou
# de concurrence ont besoin. A defaut, DATABASE_URL est utilisee.
DATABASE_URL_MIGRATION=
